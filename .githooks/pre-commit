#!/bin/sh
# Refuse to commit secrets or personal data. Scans the lines this commit adds
# (and the names of added files) with the same rules as Madeira Dock's
# tools/check-privacy.py; keep the two copies (here and pre-push) in sync.
# Enable with: git config core.hooksPath .githooks

# --- secret/personal-data scan (shared with pre-push) ------------------------
# Personal user paths: C:\Users\<name>, /home/<name>, /Users/<name>.
scan_user='(^|[^A-Za-z0-9_])([A-Za-z]:)?[\\/]+(Users|users|home|Documents and Settings)[\\/]+[A-Za-z0-9][A-Za-z0-9._-]*'
scan_user_ok='[\\/](public|default|default user|all users|shared|guest|user|username|name|you|me|someone|example|runner|steamuser|wineuser|madeira|mobile|build_user|crossover)$'
scan_email='[A-Za-z0-9._%+-]+@[A-Za-z0-9-]+(\.[A-Za-z0-9-]+)*\.[A-Za-z]{2,}'
scan_email_ok='^noreply@(anthropic|github)\.com$|@users\.noreply\.github\.com$|^git@github\.com$|@example\.(com|org|net)$|\.(invalid|test|example|localhost)$|@[0-9]+x\.[a-z]+$'
# Third-party licence texts legitimately carry their authors' addresses.
scan_licence='^((.*/)?(LICENSES|notices)/[^	]*|(.*/)?(COPYING|LICENSE[^/	]*|NOTICE[^/	]*|THIRD[-_]PARTY[^/	]*))	'
# JWT-like tokens (Steam refresh/access tokens), keys, common API tokens.
scan_secret='ey[A-Za-z0-9_-]{10,}\.ey[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}|-----BEGIN ([A-Z]+ )*PRIVATE KEY-----|gh[pousr]_[A-Za-z0-9]{36,}|github_pat_[A-Za-z0-9_]{40,}|AKIA[0-9A-Z]{16}|sk-ant-[A-Za-z0-9_-]{20,}|xox[abprs]-[A-Za-z0-9-]{10,}'
# Real-looking SteamID64; the two synthetic test IDs (accounts 0 and 1) are allowed.
scan_steamid='(^|[^0-9])7656119[0-9]{10}([^0-9]|$)'
scan_steamid_ok='^(76561197960265728|76561197960265729)$'
# Steam login cache (loginusers.vdf / config.vdf) keys and files.
scan_vdf='"(AccountName|PersonaName|RememberPassword|AllowAutoLogin|WantsOfflineMode|SkipOfflineModeWarning|ConnectCache)"[[:space:]]+"'
scan_names='(^|/)((loginusers|config|localconfig)\.vdf|ssfn[^/]*)$'

# Turn a unified diff on stdin into "path<TAB>added line" records.
scan_added_lines() {
    awk '/^diff --git /{hdr=1; next}
         hdr && /^\+\+\+ /{p=substr($0,5); sub(/^b\//,"",p); next}
         /^@@/{hdr=0; next}
         !hdr && /^\+/{print p "\t" substr($0,2)}'
}

# $1: file of "path<TAB>line" records, $2: file of added paths. Prints findings.
scan_report() {
    {
        grep -oE "$scan_user" "$1" | grep -viE "$scan_user_ok" | sed 's/^[^A-Za-z\\/]//;s/^/user-path: /'
        grep -vE "$scan_licence" "$1" | grep -oE "$scan_email" | grep -viE "$scan_email_ok" | sed 's/^/email: /'
        grep -oE "$scan_secret" "$1" | sed 's/^/token-or-key: /'
        grep -oE "$scan_steamid" "$1" | grep -oE '7656119[0-9]{10}' | grep -vE "$scan_steamid_ok" | sed 's/^/steamid: /'
        grep -oE "$scan_vdf" "$1" | sed 's/^/steam-login-cache: /'
        grep -iE "$scan_names" "$2" | sed 's/^/steam-login-cache-file: /'
    } | sort -u
}
# -----------------------------------------------------------------------------

tmp=$(mktemp -d) || exit 1
trap 'rm -rf "$tmp"' EXIT
git diff --cached -U0 --no-color --no-ext-diff --diff-filter=ACMR | scan_added_lines > "$tmp/lines"
git diff --cached --name-only --diff-filter=ACR > "$tmp/names"
found=$(scan_report "$tmp/lines" "$tmp/names")
if [ -n "$found" ]; then
    echo "pre-commit: possible secret or personal data in staged changes:" >&2
    printf '%s\n' "$found" | sed 's/^/  /' >&2
    echo "Remove it (tokens, login caches, account IDs, personal paths/emails) and restage." >&2
    exit 1
fi
exit 0
